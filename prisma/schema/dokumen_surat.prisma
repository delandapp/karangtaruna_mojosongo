model m_jenis_surat {
  id              Int      @id @default(autoincrement())
  nama_jenis      String   @unique
  prefix_nomor    String?
  template_url    String?
  dibuat_pada     DateTime @default(now())
  diperbarui_pada DateTime @updatedAt
  surat           surat[]
}

model surat {
  id                     Int            @id @default(autoincrement())
  event_id               Int?
  m_jenis_surat_id       Int?
  dibuat_oleh_id         Int
  ditandatangani_oleh_id Int?
  nomor_surat            String?        @unique
  perihal                String
  tujuan_kepada          String?
  konten                 String?
  url_file               String?
  arah_surat             String
  status                 String         @default("draft")
  tanggal_surat          DateTime
  ditandatangani_pada    DateTime?
  dibuat_pada            DateTime       @default(now())
  diperbarui_pada        DateTime       @updatedAt
  dibuat_oleh            m_user         @relation("surat_dibuat_oleh", fields: [dibuat_oleh_id], references: [id])
  ditandatangani_oleh    m_user?        @relation("surat_ditandatangani_oleh", fields: [ditandatangani_oleh_id], references: [id])
  event                  event?         @relation(fields: [event_id], references: [id])
  jenis_surat            m_jenis_surat? @relation(fields: [m_jenis_surat_id], references: [id])

  @@index([event_id])
  @@index([m_jenis_surat_id])
  @@index([dibuat_oleh_id])
  @@index([ditandatangani_oleh_id])
  @@index([status])
  @@index([arah_surat])
}

model dokumen {
  id               Int      @id @default(autoincrement())
  event_id         Int?
  diunggah_oleh_id Int
  nama_dokumen     String
  jenis_dokumen    String
  url_file         String
  ukuran_kb        Int?
  versi            Int      @default(1)
  level_akses      String   @default("anggota")
  tag              Json?
  catatan          String?
  diunggah_pada    DateTime @default(now())
  diperbarui_pada  DateTime @updatedAt
  diunggah_oleh    m_user   @relation(fields: [diunggah_oleh_id], references: [id])
  event            event?   @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([diunggah_oleh_id])
  @@index([jenis_dokumen])
}

model laporan {
  id                Int       @id @default(autoincrement())
  event_id          Int?
  dibuat_oleh_id    Int
  disetujui_oleh_id Int?
  jenis_laporan     String
  judul             String
  periode_mulai     DateTime?
  periode_selesai   DateTime?
  isi_laporan       Json?
  url_file          String?
  status            String    @default("draft")
  catatan           String?
  disetujui_pada    DateTime?
  dibuat_pada       DateTime  @default(now())
  diperbarui_pada   DateTime  @updatedAt
  dibuat_oleh       m_user    @relation("laporan_dibuat_oleh", fields: [dibuat_oleh_id], references: [id])
  disetujui_oleh    m_user?   @relation("laporan_disetujui_oleh", fields: [disetujui_oleh_id], references: [id])
  event             event?    @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([dibuat_oleh_id])
  @@index([disetujui_oleh_id])
  @@index([status])
}
