model media_galeri {
  id               Int      @id @default(autoincrement())
  event_id         Int?
  diunggah_oleh_id Int
  jenis_media      String
  judul            String?
  url_file         String
  url_thumbnail    String?
  is_publik        Boolean  @default(true)
  is_unggulan      Boolean  @default(false)
  tag              Json?
  diunggah_pada    DateTime @default(now())
  diunggah_oleh    m_user   @relation(fields: [diunggah_oleh_id], references: [id])
  event            event?   @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([diunggah_oleh_id])
  @@index([is_publik])
  @@index([is_unggulan])
}
