model survei_kepuasan {
  id              Int             @id @default(autoincrement())
  event_id        Int
  dibuat_oleh_id  Int
  jenis_survei    String
  judul           String
  pertanyaan      Json
  buka_pada       DateTime
  tutup_pada      DateTime
  total_respons   Int             @default(0)
  rata_rata_nilai Decimal?        @db.Decimal(4, 2)
  skor_nps        Decimal?        @db.Decimal(5, 2)
  is_aktif        Boolean         @default(true)
  dibuat_pada     DateTime        @default(now())
  diperbarui_pada DateTime        @updatedAt
  respon          respon_survei[]
  dibuat_oleh     m_user          @relation(fields: [dibuat_oleh_id], references: [id])
  event           event           @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([dibuat_oleh_id])
  @@index([is_aktif])
}

model respon_survei {
  id                Int             @id @default(autoincrement())
  survei_id         Int
  user_id           Int?
  nama_responden    String?
  usia_responden    Int?
  tipe_responden    String?
  jawaban           Json
  nilai_keseluruhan Decimal?        @db.Decimal(4, 2)
  nilai_nps         Int?
  is_anonim         Boolean         @default(false)
  dikirim_pada      DateTime        @default(now())
  survei            survei_kepuasan @relation(fields: [survei_id], references: [id], onDelete: Cascade)
  user              m_user?         @relation("respon_user", fields: [user_id], references: [id])

  @@index([survei_id])
  @@index([user_id])
}

model saran_masukan {
  id                Int       @id @default(autoincrement())
  event_id          Int?
  user_id           Int?
  ditangani_oleh_id Int?
  kategori          String
  subjek            String
  isi               String
  url_lampiran      String?
  nama_pengirim     String?
  is_anonim         Boolean   @default(false)
  status            String    @default("diterima")
  balasan_admin     String?
  dibalas_pada      DateTime?
  dikirim_pada      DateTime  @default(now())
  diperbarui_pada   DateTime  @updatedAt
  ditangani_oleh    m_user?   @relation("saran_ditangani_oleh", fields: [ditangani_oleh_id], references: [id])
  event             event?    @relation(fields: [event_id], references: [id])
  user              m_user?   @relation("saran_dari_user", fields: [user_id], references: [id])

  @@index([event_id])
  @@index([user_id])
  @@index([ditangani_oleh_id])
  @@index([status])
  @@index([kategori])
}
