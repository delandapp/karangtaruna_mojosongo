model m_notulen {
  id                Int                  @id @default(autoincrement())
  m_rapat_id        Int                  @unique
  m_user_id         Int
  m_approver_id     Int?
  nomor_notulen     String?              @unique
  status            StatusNotulen        @default(DRAFT)
  pembukaan         String?
  penutupan         String?
  kesimpulan_umum   String?
  diajukan_pada     DateTime?
  disetujui_pada    DateTime?
  catatan_penolakan String?
  dibuat_pada       DateTime             @default(now())
  diperbarui_pada   DateTime             @updatedAt
  keputusan         c_keputusan_rapat[]
  komentar          c_komentar_notulen[]
  lampiran          c_lampiran_notulen[]
  poin_bahasan      c_poin_bahasan[]
  riwayat_revisi    c_revisi_notulen[]
  tindak_lanjut     c_tindak_lanjut[]
  approver          m_user?              @relation("notulen_disetujui", fields: [m_approver_id], references: [id])
  rapat             m_rapat              @relation(fields: [m_rapat_id], references: [id], onDelete: Cascade)
  notulis           m_user               @relation("notulen_dibuat", fields: [m_user_id], references: [id])

  @@index([m_user_id])
  @@index([m_approver_id])
  @@index([status])
}

model c_poin_bahasan {
  id                Int             @id @default(autoincrement())
  m_notulen_id      Int
  c_agenda_rapat_id Int?
  urutan            Int
  isi_bahasan       String
  pembicara         String?
  dibuat_pada       DateTime        @default(now())
  diperbarui_pada   DateTime        @updatedAt
  agenda            c_agenda_rapat? @relation(fields: [c_agenda_rapat_id], references: [id])
  notulen           m_notulen       @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)

  @@index([m_notulen_id])
  @@index([c_agenda_rapat_id])
}

model c_keputusan_rapat {
  id              Int               @id @default(autoincrement())
  m_notulen_id    Int
  urutan          Int
  isi_keputusan   String
  dasar_keputusan String?
  is_konsensus    Boolean           @default(true)
  dibuat_pada     DateTime          @default(now())
  diperbarui_pada DateTime          @updatedAt
  notulen         m_notulen         @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)
  tindak_lanjut   c_tindak_lanjut[]

  @@index([m_notulen_id])
}

model c_tindak_lanjut {
  id                   Int                      @id @default(autoincrement())
  m_notulen_id         Int
  c_keputusan_rapat_id Int?
  m_user_id_pic        Int?
  m_user_id_pembuat    Int
  judul                String
  deskripsi            String?
  deadline             DateTime?
  prioritas            String                   @default("SEDANG")
  status               StatusTindakLanjut       @default(BELUM_MULAI)
  progres_persen       Int                      @default(0)
  catatan_progres      String?
  diselesaikan_pada    DateTime?
  dibuat_pada          DateTime                 @default(now())
  diperbarui_pada      DateTime                 @updatedAt
  keputusan            c_keputusan_rapat?       @relation(fields: [c_keputusan_rapat_id], references: [id])
  notulen              m_notulen                @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)
  pembuat              m_user                   @relation("tindak_lanjut_dibuat", fields: [m_user_id_pembuat], references: [id])
  pic                  m_user?                  @relation("tindak_lanjut_pic", fields: [m_user_id_pic], references: [id])
  update_progres       c_update_tindak_lanjut[]

  @@index([m_notulen_id])
  @@index([m_user_id_pic])
  @@index([status])
  @@index([deadline])
}

model c_update_tindak_lanjut {
  id                 Int                @id @default(autoincrement())
  c_tindak_lanjut_id Int
  m_user_id          Int
  keterangan         String
  progres_persen     Int
  status_baru        StatusTindakLanjut
  dibuat_pada        DateTime           @default(now())
  tindak_lanjut      c_tindak_lanjut    @relation(fields: [c_tindak_lanjut_id], references: [id], onDelete: Cascade)
  user               m_user             @relation("update_tl_oleh", fields: [m_user_id], references: [id])

  @@index([c_tindak_lanjut_id])
  @@index([m_user_id])
}

model c_lampiran_notulen {
  id            Int       @id @default(autoincrement())
  m_notulen_id  Int
  m_user_id     Int
  nama_file     String
  nama_asli     String
  tipe_file     String
  ukuran_bytes  Int
  url_file      String
  deskripsi     String?
  dibuat_pada   DateTime  @default(now())
  notulen       m_notulen @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)
  diunggah_oleh m_user    @relation("lampiran_notulen_diunggah", fields: [m_user_id], references: [id])

  @@index([m_notulen_id])
  @@index([m_user_id])
}

model c_komentar_notulen {
  id              Int                  @id @default(autoincrement())
  m_notulen_id    Int
  m_user_id       Int
  parent_id       Int?
  isi_komentar    String
  is_resolved     Boolean              @default(false)
  dibuat_pada     DateTime             @default(now())
  diperbarui_pada DateTime             @updatedAt
  notulen_ref     m_notulen            @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)
  user            m_user               @relation("komentar_notulen_oleh", fields: [m_user_id], references: [id])
  parent          c_komentar_notulen?  @relation("komentar_reply", fields: [parent_id], references: [id])
  balasan         c_komentar_notulen[] @relation("komentar_reply")

  @@index([m_notulen_id])
  @@index([m_user_id])
  @@index([parent_id])
}

model c_revisi_notulen {
  id             Int           @id @default(autoincrement())
  m_notulen_id   Int
  m_user_id      Int
  nomor_revisi   Int
  snapshot_json  String
  catatan_revisi String?
  status_dari    StatusNotulen
  status_ke      StatusNotulen
  dibuat_pada    DateTime      @default(now())
  notulen        m_notulen     @relation(fields: [m_notulen_id], references: [id], onDelete: Cascade)
  direvisi_oleh  m_user        @relation("revisi_notulen_oleh", fields: [m_user_id], references: [id])

  @@index([m_notulen_id])
  @@index([m_user_id])
}
