model m_kategori_rapat {
  id              Int       @id @default(autoincrement())
  nama_kategori   String    @unique
  deskripsi       String?
  warna_hex       String?
  is_aktif        Boolean   @default(true)
  dibuat_pada     DateTime  @default(now())
  diperbarui_pada DateTime  @updatedAt
  rapats          m_rapat[]
}

model m_rapat {
  id                  Int               @id @default(autoincrement())
  m_kategori_rapat_id Int?
  m_user_id           Int
  event_id            Int?
  judul_rapat         String
  jenis_rapat         JenisRapat        @default(INTERNAL)
  status_rapat        StatusRapat       @default(TERJADWAL)
  deskripsi           String?
  tanggal_mulai       DateTime
  tanggal_selesai     DateTime?
  lokasi              String?
  link_online         String?
  is_online           Boolean           @default(false)
  nomor_rapat         String?           @unique
  is_recurring        Boolean           @default(false)
  dibuat_pada         DateTime          @default(now())
  diperbarui_pada     DateTime          @updatedAt
  agendas             c_agenda_rapat[]
  peserta             c_peserta_rapat[]
  notulen             m_notulen?
  event               event?            @relation(fields: [event_id], references: [id])
  kategori            m_kategori_rapat? @relation(fields: [m_kategori_rapat_id], references: [id])
  dibuat_oleh         m_user            @relation("rapat_dibuat", fields: [m_user_id], references: [id])

  @@index([m_user_id])
  @@index([m_kategori_rapat_id])
  @@index([event_id])
  @@index([status_rapat])
  @@index([tanggal_mulai])
}

model c_agenda_rapat {
  id              Int              @id @default(autoincrement())
  m_rapat_id      Int
  m_user_id       Int?
  urutan          Int
  judul_agenda    String
  deskripsi       String?
  durasi_menit    Int?
  dibuat_pada     DateTime         @default(now())
  diperbarui_pada DateTime         @updatedAt
  rapat           m_rapat          @relation(fields: [m_rapat_id], references: [id], onDelete: Cascade)
  pic             m_user?          @relation("agenda_pic", fields: [m_user_id], references: [id])
  poin_bahasan    c_poin_bahasan[]

  @@index([m_rapat_id])
  @@index([m_user_id])
}

model c_peserta_rapat {
  id                Int             @id @default(autoincrement())
  m_rapat_id        Int
  m_user_id         Int?
  nama_peserta      String
  jabatan_peserta   String?
  instansi          String?
  email             String?
  no_handphone      String?
  status_kehadiran  StatusKehadiran @default(DIUNDANG)
  waktu_hadir       DateTime?
  catatan_kehadiran String?
  tanda_tangan_url  String?
  is_moderator      Boolean         @default(false)
  is_notulis        Boolean         @default(false)
  dibuat_pada       DateTime        @default(now())
  diperbarui_pada   DateTime        @updatedAt
  rapat             m_rapat         @relation(fields: [m_rapat_id], references: [id], onDelete: Cascade)
  user              m_user?         @relation("peserta_rapat", fields: [m_user_id], references: [id])

  @@unique([m_rapat_id, m_user_id])
  @@index([m_rapat_id])
  @@index([m_user_id])
}
