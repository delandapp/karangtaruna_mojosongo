model notifikasi {
  id            Int       @id @default(autoincrement())
  user_id       Int
  event_id      Int?
  jenis_notif   String
  judul         String
  isi           String
  channel       String
  tabel_rujukan String?
  id_rujukan    Int?
  sudah_dibaca  Boolean   @default(false)
  dibaca_pada   DateTime?
  dibuat_pada   DateTime  @default(now())
  event         event?    @relation(fields: [event_id], references: [id])
  user          m_user    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([event_id])
  @@index([sudah_dibaca])
  @@index([dibuat_pada])
}

model log_audit {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  aksi        String
  nama_tabel  String
  id_record   Int?
  data_lama   Json?
  data_baru   Json?
  ip_address  String?
  user_agent  String?
  keterangan  String?
  dibuat_pada DateTime @default(now())
  user        m_user?  @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([nama_tabel])
  @@index([aksi])
  @@index([dibuat_pada])
}
