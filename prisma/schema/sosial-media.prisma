model m_platform {
  id              Int                 @id @default(autoincrement())
  nama            String
  slug            String              @unique
  ikon_url        String?
  aktif           Boolean             @default(true)
  dibuat_pada     DateTime            @default(now())
  diperbarui_pada DateTime            @updatedAt
  dihapus_pada    DateTime?
  akun            m_akun_sosmed[]
  konten          r_konten_platform[]
}

model m_akun_sosmed {
  id               Int          @id @default(autoincrement())
  platform_id      Int
  nama_akun        String
  username         String
  access_token     String
  refresh_token    String?
  token_expires_at DateTime?
  status           String       @default("terhubung")
  dibuat_pada      DateTime     @default(now())
  diperbarui_pada  DateTime     @updatedAt
  dihapus_pada     DateTime?
  platform         m_platform   @relation(fields: [platform_id], references: [id])
  analitik         m_analitik[]
  chat             m_chat[]
  konten           m_konten[]
  kontak_wa        m_kontak_wa[]
  blazzing_wa      m_blazzing_wa[]
}

model m_konten {
  id               Int                 @id @default(autoincrement())
  akun_id          Int
  judul            String?
  caption          String?
  tipe_konten      String
  status           String              @default("draft")
  dijadwalkan_pada DateTime?
  diposting_pada   DateTime?
  dibuat_pada      DateTime            @default(now())
  diperbarui_pada  DateTime            @updatedAt
  dihapus_pada     DateTime?
  jadwal           c_jadwal_konten[]
  media            c_media_konten[]
  akun             m_akun_sosmed       @relation(fields: [akun_id], references: [id])
  platform         r_konten_platform[]
}

model c_media_konten {
  id              Int       @id @default(autoincrement())
  konten_id       Int
  url             String
  tipe_media      String
  urutan          Int       @default(0)
  dibuat_pada     DateTime  @default(now())
  diperbarui_pada DateTime  @updatedAt
  dihapus_pada    DateTime?
  konten          m_konten  @relation(fields: [konten_id], references: [id])
}

model c_jadwal_konten {
  id              Int       @id @default(autoincrement())
  konten_id       Int
  waktu_posting   DateTime
  status_job      String    @default("pending")
  pesan_error     String?
  dibuat_pada     DateTime  @default(now())
  diperbarui_pada DateTime  @updatedAt
  dihapus_pada    DateTime?
  konten          m_konten  @relation(fields: [konten_id], references: [id])
}

model m_chat {
  id              Int              @id @default(autoincrement())
  akun_id         Int
  sender_id       String
  sender_nama     String
  pesan           String
  sudah_dibaca    Boolean          @default(false)
  status          String           @default("baru")
  platform_msg_id String?
  dibuat_pada     DateTime         @default(now())
  diperbarui_pada DateTime         @updatedAt
  dihapus_pada    DateTime?
  balasan         c_balasan_chat[]
  akun            m_akun_sosmed    @relation(fields: [akun_id], references: [id])
}

model c_balasan_chat {
  id              Int       @id @default(autoincrement())
  chat_id         Int
  isi_balasan     String
  dikirim_oleh    String
  berhasil        Boolean   @default(false)
  platform_msg_id String?
  dibuat_pada     DateTime  @default(now())
  diperbarui_pada DateTime  @updatedAt
  dihapus_pada    DateTime?
  chat            m_chat    @relation(fields: [chat_id], references: [id])
}

model m_analitik {
  id              Int           @id @default(autoincrement())
  akun_id         Int
  tanggal         DateTime
  followers       Int           @default(0)
  reach           Int           @default(0)
  impressions     Int           @default(0)
  engagement      Int           @default(0)
  likes           Int           @default(0)
  komentar        Int           @default(0)
  share           Int           @default(0)
  dibuat_pada     DateTime      @default(now())
  diperbarui_pada DateTime      @updatedAt
  dihapus_pada    DateTime?
  akun            m_akun_sosmed @relation(fields: [akun_id], references: [id])
}

model r_konten_platform {
  id               Int        @id @default(autoincrement())
  konten_id        Int
  platform_id      Int
  external_post_id String?
  dibuat_pada      DateTime   @default(now())
  diperbarui_pada  DateTime   @updatedAt
  dihapus_pada     DateTime?
  konten           m_konten   @relation(fields: [konten_id], references: [id])
  platform         m_platform @relation(fields: [platform_id], references: [id])
}

model m_kontak_wa {
  id               Int                 @id @default(autoincrement())
  akun_id          Int
  nama             String
  nomor_telp       String
  email            String?
  perusahaan       String?
  jabatan          String?
  grup             String?
  catatan          String?
  dibuat_pada      DateTime            @default(now())
  diperbarui_pada  DateTime            @updatedAt
  dihapus_pada     DateTime?
  akun             m_akun_sosmed       @relation(fields: [akun_id], references: [id])
  blazzing_penerima c_blazzing_penerima[]
}

model m_blazzing_wa {
  id               Int                 @id @default(autoincrement())
  akun_id          Int
  nama_kempen      String
  pesan            String
  tipe             String              @default("instant") // "instant" | "scheduled"
  status           String              @default("pending") // "pending" | "processing" | "sent" | "failed"
  dijadwalkan_pada DateTime?
  dibuat_pada      DateTime            @default(now())
  diperbarui_pada  DateTime            @updatedAt
  dihapus_pada     DateTime?
  akun             m_akun_sosmed       @relation(fields: [akun_id], references: [id])
  penerima         c_blazzing_penerima[]
}

model c_blazzing_penerima {
  id              Int            @id @default(autoincrement())
  blazzing_id     Int
  kontak_id       Int?
  nama            String
  nomor_telp      String
  status          String         @default("pending") // "pending" | "sent" | "failed"
  dikirim_pada    DateTime?
  pesan_error     String?
  pesan_terformat String?
  dibuat_pada     DateTime       @default(now())
  diperbarui_pada DateTime       @updatedAt
  dihapus_pada    DateTime?
  blazzing        m_blazzing_wa  @relation(fields: [blazzing_id], references: [id])
  kontak          m_kontak_wa?   @relation(fields: [kontak_id], references: [id])
}
