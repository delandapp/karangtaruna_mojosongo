model jenis_tiket {
  id              Int           @id @default(autoincrement())
  event_id        Int
  nama_tiket      String
  kategori_tiket  String
  harga           Decimal       @default(0) @db.Decimal(12, 2)
  kuota           Int
  terjual         Int           @default(0)
  keuntungan      Json?
  penjualan_buka  DateTime
  penjualan_tutup DateTime
  is_aktif        Boolean       @default(true)
  event           event         @relation(fields: [event_id], references: [id], onDelete: Cascade)
  order           tiket_order[]

  @@index([event_id])
  @@index([is_aktif])
}

model tiket_order {
  id              Int            @id @default(autoincrement())
  jenis_tiket_id  Int
  user_id         Int?
  nomor_order     String         @unique
  nama_pembeli    String
  email_pembeli   String
  hp_pembeli      String
  jumlah          Int
  total_harga     Decimal        @db.Decimal(12, 2)
  status_bayar    String         @default("menunggu")
  metode_bayar    String?
  bukti_bayar_url String?
  dibayar_pada    DateTime?
  dibuat_pada     DateTime       @default(now())
  diperbarui_pada DateTime       @updatedAt
  jenis_tiket     jenis_tiket    @relation(fields: [jenis_tiket_id], references: [id])
  user            m_user?        @relation(fields: [user_id], references: [id])
  tiket_terbit    tiket_terbit[]

  @@index([jenis_tiket_id])
  @@index([user_id])
  @@index([status_bayar])
  @@index([nomor_order])
}

model tiket_terbit {
  id               Int         @id @default(autoincrement())
  order_id         Int
  dicek_oleh_id    Int?
  kode_tiket       String      @unique
  qr_code          String
  nama_pemegang    String
  status           String      @default("aktif")
  checkin_pada     DateTime?
  diterbitkan_pada DateTime    @default(now())
  dicek_oleh       m_user?     @relation("tiket_dicek_oleh", fields: [dicek_oleh_id], references: [id])
  order            tiket_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([dicek_oleh_id])
  @@index([status])
}
